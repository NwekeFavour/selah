# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
SELAH_SERVICE_KEY=

# Local development defaults to SQLite unless `USE_PRODUCTION_DB=1` is set explicitly.
# For production, set USE_PRODUCTION_DB=1 and use your Supabase Postgres connection string.
USE_PRODUCTION_DB=0
DATABASE_URL=

# LiveKit Cloud (or self-hosted). URL is what browsers connect to.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
